# Local FastAPI execution example. Copy this file to .env and replace values.
DB_USER=ozcoding
DB_PASSWORD=replace-with-your-local-password
DB_ROOT_PASSWORD=replace-with-your-local-root-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_health
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# `fastapi run app/main.py` is HTTP in local development.
# Set this to true only behind HTTPS in deployment.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
